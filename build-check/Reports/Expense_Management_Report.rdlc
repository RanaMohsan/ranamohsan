      <Textbox Name="FilterSummary">
        <CanGrow>true</CanGrow><KeepTogether>true</KeepTogether>
        <Paragraphs><Paragraph><TextRuns><TextRun><Value>=Parameters!FromDate.Value &amp; " to " &amp; Parameters!ToDate.Value &amp; " | " &amp; Parameters!Branch.Value &amp; " | " &amp; Parameters!ExpenseCategory.Value</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>9pt</FontSize><Color>#667085</Color></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs>
        <Top>0.52in</Top><Left>0.10in</Left><Height>0.25in</Height><Width>7.10in</Width><Style />
