              <TablixCell><CellContents><Textbox Name="DCreatedBy"><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!CreatedBy.Value</Value><Style /></TextRun></TextRuns><Style /></Paragraph></Paragraphs><Style><Border><Color>#D8E0E8</Color><Style>Solid</Style></Border><PaddingLeft>4pt</PaddingLeft></Style></Textbox></CellContents></TablixCell>
            </TablixCells></TablixRow>
            <TablixRow><Height>0.34in</Height><TablixCells>
              <TablixCell><CellContents><Textbox Name="TLabel"><Paragraphs><Paragraph><TextRuns><TextRun><Value>Grand Total of Expenses</Value><Style><FontWeight>Bold</FontWeight><Color>#004578</Color></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><Style><BackgroundColor>#EEF4FB</BackgroundColor><PaddingLeft>4pt</PaddingLeft><PaddingTop>4pt</PaddingTop></Style></Textbox><ColSpan>3</ColSpan></CellContents></TablixCell>
              <TablixCell><CellContents><Textbox Name="TAmount"><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Sum(Fields!Amount.Value)</Value><Style><FontWeight>Bold</FontWeight><Format>N2</Format><Color>#004578</Color></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><Style><BackgroundColor>#EEF4FB</BackgroundColor><TextAlign>Right</TextAlign><PaddingRight>4pt</PaddingRight><PaddingTop>4pt</PaddingTop></Style></Textbox></CellContents></TablixCell>
              <TablixCell><CellContents><Textbox Name="TBlank1"><Paragraphs><Paragraph><TextRuns><TextRun><Value /></TextRun></TextRuns></Paragraph></Paragraphs><Style><BackgroundColor>#EEF4FB</BackgroundColor></Style></Textbox></CellContents></TablixCell>
              <TablixCell><CellContents><Textbox Name="TBlank2"><Paragraphs><Paragraph><TextRuns><TextRun><Value /></TextRun></TextRuns></Paragraph></Paragraphs><Style><BackgroundColor>#EEF4FB</BackgroundColor></Style></Textbox></CellContents></TablixCell>
