      <Tablix Name="ExpenseTable">
        <TablixBody>
          <TablixColumns>
            <TablixColumn><Width>0.85in</Width></TablixColumn><TablixColumn><Width>1.15in</Width></TablixColumn><TablixColumn><Width>2.05in</Width></TablixColumn><TablixColumn><Width>0.90in</Width></TablixColumn><TablixColumn><Width>1.15in</Width></TablixColumn><TablixColumn><Width>1.00in</Width></TablixColumn>
